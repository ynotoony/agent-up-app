          "if": {
            "properties": {
              "name": {
                "const": "put_task"
              }
            },
            "required": [
              "name"
            ]
          },
          "then": {
            "properties": {
              "input_required": {
                "const": [
                  "project_id",
                  "task_id",
                  "request_id",
                  "title",
                  "parent_id",
                  "depends_on",
                  "expected_revision"
                ]
              },
              "output_required": {
                "const": [
                  "fact"
                ]
              },
              "side_effect": {
                "const": "project_agentup_write"
              },
              "errors": {
                "const": [
                  "invalid_input",
                  "not_initialized",
                  "path_outside_project",
                  "revision_conflict",
                  "malformed_fact",
                  "malformed_event",
                  "event_replay",
                  "permission_denied",
                  "io_error"
                ]
              },
              "capability": {
                "const": "project_agentup_write"
              },
              "emits": {
                "const": []
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "set_task_state"
              }
            },
            "required": [
              "name"
            ]
          },
          "then": {
            "properties": {
              "input_required": {
                "const": [
                  "task_id",
                  "task_state",
                  "expected_revision"
