              "side_effect": {
                "const": "none"
              },
              "errors": {
                "const": [
                  "invalid_input",
                  "path_not_found",
                  "path_outside_project",
                  "not_initialized",
                  "permission_denied",
                  "io_error"
                ]
              },
              "capability": {
                "const": "project_read"
              },
              "emits": {
                "const": []
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "post_discussion"
              }
            },
            "required": [
              "name"
            ]
          },
          "then": {
            "properties": {
              "input_required": {
                "const": [
                  "project_id",
                  "request_id",
                  "body"
                ]
              },
              "output_required": {
                "const": [
                  "fact",
                  "event",
                  "event_id"
                ]
              },
              "side_effect": {
                "const": "project_agentup_write"
              },
              "errors": {
                "const": [
                  "invalid_input",
                  "not_initialized",
                  "path_outside_project",
                  "revision_conflict",
                  "malformed_fact",
                  "malformed_event",
                  "event_replay",
                  "permission_denied",
                  "io_error"
                ]
              },
              "capability": {
                "const": "project_agentup_write"
              },
              "emits": {
                "const": [
                  "discussion.posted"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "add_attachment"
              }
            },
            "required": [
              "name"
            ]
          },
          "then": {
            "properties": {
              "input_required": {
                "const": [
                  "project_id",
                  "request_id",
                  "media_type",
                  "bytes"
                ]
              },
              "output_required": {
                "const": [
                  "fact",
                  "relative_path",
                  "byte_length",
                  "sha256"
                ]
              },
              "side_effect": {
                "const": "project_agentup_write"
              },
              "errors": {
                "const": [
                  "invalid_input",
                  "not_initialized",
                  "path_outside_project",
                  "already_exists",
                  "revision_conflict",
                  "malformed_fact",
                  "permission_denied",
                  "io_error"
                ]
              },
              "capability": {
                "const": "project_agentup_write"
              },
              "emits": {
                "const": []
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "load_request_thread"
              }
            },
            "required": [
              "name"
            ]
          },
          "then": {
            "properties": {
              "input_required": {
                "const": [
                  "project_id",
                  "request_id"
                ]
              },
              "output_required": {
                "const": [
                  "project_id",
                  "request_id",
                  "discussions",
                  "attachments"
                ]
              },
              "side_effect": {
                "const": "none"
              },
              "errors": {
                "const": [
                  "invalid_input",
                  "not_initialized",
                  "path_outside_project",
                  "malformed_fact",
                  "permission_denied",
                  "io_error"
                ]
              },
              "capability": {
                "const": "project_read"
              },
              "emits": {
                "const": []
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "put_scope"
              }
            },
            "required": [
              "name"
            ]
          },
          "then": {
            "properties": {
              "input_required": {
                "const": [
                  "project_id",
                  "scope_id",
                  "request_id",
                  "task_id",
                  "entries",
                  "expected_revision"
                ]
              },
              "output_required": {
                "const": [
                  "fact",
                  "event",
                  "event_id"
                ]
              },
              "side_effect": {
                "const": "project_agentup_write"
              },
              "errors": {
                "const": [
                  "invalid_input",
                  "not_initialized",
                  "path_outside_project",
                  "revision_conflict",
                  "malformed_fact",
                  "malformed_event",
                  "event_replay",
                  "permission_denied",
                  "io_error"
                ]
              },
              "capability": {
                "const": "project_agentup_write"
              },
              "emits": {
                "const": [
