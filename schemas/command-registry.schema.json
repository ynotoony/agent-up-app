            },
            "required": [
              "name"
            ]
          },
          "then": {
            "properties": {
              "input_required": {
                "const": [
                  "scope_id",
                  "from_revision",
                  "to_revision"
                ]
              },
              "output_required": {
                "const": [
                  "added",
                  "removed",
                  "changed"
                ]
              },
              "side_effect": {
                "const": "none"
              },
              "errors": {
                "const": [
                  "invalid_input",
                  "not_initialized",
                  "path_outside_project",
                  "malformed_fact",
                  "permission_denied",
                  "io_error"
                ]
              },
              "capability": {
                "const": "project_read"
              },
              "emits": {
                "const": []
