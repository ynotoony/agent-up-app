{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentup:schema:fact-record",
  "title": "AgentUp Fact Record",
  "description": "Fact envelope with type-specific content for M0 runtime records and M1 user types.",
  "oneOf": [
    {
      "$ref": "#/$defs/request-record"
    },
    {
      "$ref": "#/$defs/project-record"
    },
    {
      "$ref": "#/$defs/manifest-record"
    },
    {
      "$ref": "#/$defs/discussion-record"
    },
    {
      "$ref": "#/$defs/plan-record"
    },
    {
      "$ref": "#/$defs/task-record"
    },
    {
      "$ref": "#/$defs/scope-record"
    },
    {
      "$ref": "#/$defs/run-record"
    },
    {
      "$ref": "#/$defs/decision-record"
    },
    {
      "$ref": "#/$defs/result-record"
    },
    {
      "$ref": "#/$defs/attachment-record"
    },
    {
      "$ref": "#/$defs/understanding-record"
    }
  ],
  "$defs": {
    "stable-id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "iso-date-time": {
      "type": "string",
      "format": "date-time"
    },
    "root-fingerprint": {
      "type": "string",
      "pattern": "^fp-v1:[0-9a-f]{16}$"
    },
    "relative-path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\u0000-\\u001F]+$"
    },
    "common": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "schema_version",
        "project_id",
        "request_id",
        "revision",
        "source",
        "created_at",
        "updated_at",
        "content",
        "metadata"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stable-id"
        },
        "type": {
          "type": "string"
        },
        "schema_version": {
          "const": 1
        },
        "project_id": {
          "$ref": "#/$defs/stable-id"
        },
        "request_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/stable-id"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "source": {
          "type": "string",
          "enum": [
            "user",
            "agent",
            "system",
            "tool",
            "governance_mirror"
          ]
        },
        "created_at": {
          "$ref": "#/$defs/iso-date-time"
        },
        "updated_at": {
          "$ref": "#/$defs/iso-date-time"
        },
        "content": {
          "type": "object"
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "request-content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lifecycle",
        "title",
        "body"
      ],
      "description": "schema_version 1 carries the SPEC-001 RequestLifecycle value domain. SPEC-011 drives draft -> understanding (put) and understanding/discussion/waiting_user_decision -> planning (confirm); the runtime writes only those transitions.",
      "properties": {
        "lifecycle": {
          "enum": [
            "draft",
            "understanding",
            "discussion",
            "waiting_user_decision",
            "waiting_info",
            "planning",
            "executing",
            "reviewing",
            "fixing",
            "result_ready",
            "accepted",
            "failed",
            "paused",
            "cancelled",
            "rejected"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        }
      }
    },
    "project-content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_name",
        "project_type",
        "root_fingerprint",
        "initialized"
      ],
      "properties": {
        "project_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "project_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "root_fingerprint": {
          "$ref": "#/$defs/root-fingerprint"
        },
        "initialized": {
          "type": "boolean"
        }
      }
    },
    "manifest-content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format_version",
        "project_id",
        "revision",
        "initialized_at",
        "root_fingerprint"
      ],
      "properties": {
        "format_version": {
          "const": 1
        },
        "project_id": {
          "$ref": "#/$defs/stable-id"
        },
        "revision": {
          "const": 1
        },
        "initialized_at": {
          "$ref": "#/$defs/iso-date-time"
        },
        "root_fingerprint": {
          "$ref": "#/$defs/root-fingerprint"
        }
      }
    },
    "discussion-content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "author_source",
        "body",
        "posted_at"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/stable-id"
        },
        "author_source": {
          "enum": [
            "user",
            "agent",
            "system"
          ]
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        },
        "posted_at": {
          "$ref": "#/$defs/iso-date-time"
        },
        "attachment_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stable-id"
          },
          "uniqueItems": true
        }
      }
    },
    "plan-content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "summary",
        "success_criteria",
        "constraints",
        "status"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/stable-id"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "success_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "status": {
          "enum": [
            "draft",
            "active",
            "superseded"
          ]
        }
      }
    },
    "task-content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "title",
        "task_state",
        "parent_id"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/stable-id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "task_state": {
          "enum": [
            "ready",
            "in_progress",
            "blocked",
            "review_ready",
            "review_pass",
            "review_fail",
            "done"
          ]
        },
        "parent_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/stable-id"
            },
            {
              "type": "null"
            }
          ]
        },
        "depends_on": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stable-id"
          },
          "uniqueItems": true
        }
      }
    },
    "scope-entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "reason",
        "source",
        "included"
      ],
      "properties": {
        "relative_path": {
          "$ref": "#/$defs/relative-path"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "source": {
          "enum": [
            "user",
            "agent",
            "system",
            "tool"
          ]
        },
        "included": {
          "type": "boolean"
        }
      }
    },
    "scope-content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "task_id",
        "entries"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/stable-id"
        },
        "task_id": {
          "$ref": "#/$defs/stable-id"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scope-entry"
          }
        }
      }
    },
    "run-content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "task_id",
        "kind",
        "run_state",
        "started_at"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/stable-id"
        },
        "task_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/stable-id"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "enum": [
            "implement",
            "review",
            "commit",
            "command",
            "verify"
          ]
        },
        "run_state": {
          "enum": [
            "active",
            "interrupted",
            "unknown",
            "recovering",
            "closed"
          ]
        },
        "started_at": {
          "$ref": "#/$defs/iso-date-time"
        },
        "ended_at": {
          "$ref": "#/$defs/iso-date-time"
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "prompt_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "context_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*@[0-9]+$"
          }
        },
        "input_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "output_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "context_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "max_context_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "agent_output": {
          "type": "object"
        },
        "reviewed_run_id": {
          "$ref": "#/$defs/stable-id"
        },
        "high_risk": {
          "type": "boolean"
        },
        "reviewer_independent": {
          "type": "boolean"
        },
        "tool_results": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "error_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "agent_key": {
          "$ref": "#/$defs/stable-id"
        },
        "governance": {
          "type": "object",
          "description": "Ticket 67 (route-S PRD §5.4, D3): the original governance run record, preserved verbatim by the import_run command (source=governance_mirror). Runtime-written runs never carry this field; optional addition is backward compatible, schema_version stays 1."
        }
      }
    },
    "decision-content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "question",
        "options",
        "status"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/stable-id"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "anyOf": [
            {
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            {
              "items": {
                "$ref": "#/$defs/decision-option"
              }
            }
          ]
        },
        "status": {
          "enum": [
            "open",
            "chosen",
            "cancelled"
          ]
        },
        "chosen": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "recommended": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "chosen"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "chosen"
            ],
            "properties": {
              "chosen": {}
            }
          }
        },
        {
          "if": {
            "properties": {
              "recommended": {}
            },
            "required": [
              "recommended"
            ]
          },
          "then": {
            "required": [
              "rationale"
            ],
            "properties": {
              "rationale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            }
          }
        }
      ]
    },
    "decision-option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "risk": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "result-content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "version",
        "summary",
        "acceptance"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/stable-id"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "acceptance": {
          "enum": [
            "pending",
            "accepted",
            "rejected"
          ]
        },
        "evidence_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relative-path"
          }
        }
      }
    },
    "understanding-content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "version",
        "goal_summary",
        "success_criteria",
        "source"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/stable-id"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "goal_summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "success_criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source": {
          "enum": [
            "initial",
            "user_feedback",
            "question_answer",
            "manual"
          ]
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "risk",
              "level"
            ],
            "properties": {
              "risk": {
                "type": "string",
                "minLength": 1
              },
              "level": {
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              }
            }
          }
        },
        "ambiguities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "item",
              "clarification"
            ],
            "properties": {
              "item": {
                "type": "string",
                "minLength": 1
              },
              "clarification": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "question",
              "options"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/stable-id"
              },
              "question": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "options": {
                "type": "array",
                "minItems": 2,
                "maxItems": 4,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              }
            }
          }
        },
        "user_input": {
          "type": "string",
          "minLength": 1
        },
        "supersedes": {
          "$ref": "#/$defs/stable-id"
        },
        "context_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*@[0-9]+$"
          }
        }
      }
    },
    "attachment-content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "relative_path",
        "media_type",
        "byte_length",
        "sha256"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/stable-id"
        },
        "relative_path": {
          "$ref": "#/$defs/relative-path"
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10485760
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "request-record": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "request"
            },
            "content": {
              "$ref": "#/$defs/request-content"
            },
            "request_id": {
              "$ref": "#/$defs/stable-id"
            },
            "source": {
              "const": "user"
            }
          }
        }
      ]
    },
    "project-record": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "project"
            },
            "content": {
              "$ref": "#/$defs/project-content"
            },
            "request_id": {
              "type": "null"
            },
            "source": {
              "enum": [
                "system",
                "tool"
              ]
            }
          }
        }
      ]
    },
    "manifest-record": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "manifest"
            },
            "content": {
              "$ref": "#/$defs/manifest-content"
            },
            "request_id": {
              "type": "null"
            },
            "source": {
              "const": "system"
            }
          }
        }
      ]
    },
    "discussion-record": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "discussion"
            },
            "content": {
              "$ref": "#/$defs/discussion-content"
            },
            "request_id": {
              "$ref": "#/$defs/stable-id"
            }
          }
        }
      ]
    },
    "plan-record": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "plan"
            },
            "content": {
              "$ref": "#/$defs/plan-content"
            },
            "request_id": {
              "$ref": "#/$defs/stable-id"
            }
          }
        }
      ]
    },
    "task-record": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "task"
            },
            "content": {
              "$ref": "#/$defs/task-content"
            },
            "request_id": {
              "$ref": "#/$defs/stable-id"
            }
          }
        }
      ]
    },
    "scope-record": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "scope"
            },
            "content": {
              "$ref": "#/$defs/scope-content"
            },
            "request_id": {
              "$ref": "#/$defs/stable-id"
            }
          }
        }
      ]
    },
    "run-record": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "run"
            },
            "content": {
              "$ref": "#/$defs/run-content"
            },
            "request_id": {
              "$ref": "#/$defs/stable-id"
            }
          }
        }
      ]
    },
    "decision-record": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "decision"
            },
            "content": {
              "$ref": "#/$defs/decision-content"
            },
            "request_id": {
              "$ref": "#/$defs/stable-id"
            }
          }
        }
      ]
    },
    "result-record": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "result"
            },
            "content": {
              "$ref": "#/$defs/result-content"
            },
            "request_id": {
              "$ref": "#/$defs/stable-id"
            }
          }
        }
      ]
    },
    "attachment-record": {
