{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentUp",
  "version": "1.1.0",
  "identifier": "com.agentup.harness",
  "build": {
    "beforeDevCommand": "pnpm exec vite",
    "devUrl": "http://127.0.0.1:5188",
    "beforeBuildCommand": "pnpm exec vite build",
    "frontendDist": "../dist/renderer"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "AgentUp",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns", "icons/32x32.png", "icons/128x128.png"],
    "resources": {
      "resources/agent-up-runtime/ticket-ops.sh": "agent-up/scripts/ticket-ops.sh",
      "resources/agent-up-runtime/generate-progress.sh": "agent-up/scripts/generate-progress.sh",
      "resources/agent-up-runtime/LICENSE": "agent-up/LICENSE",
      "resources/agent-up-runtime/ticket-record.schema.json": "agent-up/references/schemas/ticket-record.schema.json",
      "resources/agent-up-runtime/issue-index.schema.json": "agent-up/references/schemas/issue-index.schema.json"
    }
  }
}
