{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentUp Harness",
  "version": "1.0.0",
  "identifier": "com.agentup.harness",
  "build": {
    "beforeDevCommand": "pnpm exec vite",
    "devUrl": "http://127.0.0.1:5188",
    "beforeBuildCommand": "pnpm exec vite build",
    "frontendDist": "../dist/renderer"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "AgentUp Harness",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 700,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.icns", "icons/32x32.png", "icons/128x128.png"]
  }
}
